<div class="category-header">
    <a href="<%= categories_path %>">
        <i class="fa-solid fa-arrow-left"></i>
    </a>
    <h2>New Transaction</h2>
    <a href="/logout">
        <i class="fa-solid fa-right-from-bracket"></i>
    </a>
</div>

<%= form_with(model: @payment, url: category_payments_path) do |form| %>
    <div class="form-wrapper">
        <div class="form-container">
            <%= form.text_field :name, placeholder: "Name", pattern: ".*", required: true %>
            <% if @payment.errors.has_key?(:name) %>
                <p class="error-message"><%= @payment.errors[:name].first %></p>
            <% end %>
            <%= form.text_field :amount, placeholder: "Amount (Enter Numbers only)", pattern: "^\\d+(\\.\\d+)?$" %>
            <% if @payment.errors.has_key?(:amount) %>
                <p class="error-message"><%= @payment.errors[:amount].first %></p>
            <% end %>
            <%= form.submit "Create", class: "submit-button" %>
        </div>
    </div>
<% end %>
